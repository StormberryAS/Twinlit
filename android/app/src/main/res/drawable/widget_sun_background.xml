<?xml version="1.0" encoding="utf-8"?>
<!--
  The home screen widgets' panel (1.1.9): the app's background, #080C18, at 70 per cent opacity
  (alpha B3), so the wallpaper shows through. Every widget text colour keeps a contrast of at
  least 4.5 to 1 against this panel over pure white and over pure black; WidgetColorsTest
  guards it (colors.xml has the rule).
  The corners follow the system's widget radius on Android 12 and later (values-v31/dimens.xml).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/widget_sun_panel" />
    <corners android:radius="@dimen/widget_radius" />
</shape>
