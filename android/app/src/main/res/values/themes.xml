<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose draws everything, so this theme only needs to cover the window before the first
      frame. NoActionBar plus the night background stops the launch flash. The window background
      stays #080C18 in every theme (DECISIONS D45): the window theme is applied before the app can
      know the Auto phase, so a light background would be wrong at night.
    -->
    <style name="Theme.Twinlit" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/twinlit_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
